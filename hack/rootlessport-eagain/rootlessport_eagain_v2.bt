#!/usr/bin/env bpftrace
/*
 * rootlessport_eagain_v2.bt - Improved rootlessport EAGAIN stall tracer
 *
 * Improvements over v1 to address reviewer concerns:
 *
 * 1. fd-level tracking on EAGAIN:
 *    @eagain_fd[tid] records which fd_in got EAGAIN. At SPLICE_SUCCESS
 *    the fd is compared: if it changed, the measurement is labelled
 *    [cross-fd, discarded] instead of producing a misleading delay value.
 *
 * 2. epoll_pwait confirmation of fd readiness:
 *    Go's netpoller calls epoll_pwait(2) to get events. When it returns
 *    > 0 the kernel has confirmed at least one fd is ready. We record
 *    this per-pid. When a stall >1s is detected AND epoll_pwait fired
 *    during the EAGAIN window, the alert is labelled CONFIRMED ALERT:
 *      "fd kernel-confirmed ready Xms before splice succeeded"
 *    This directly answers "we don't know if the fd was ready".
 *
 * 3. Two delay measurements with explicit labels:
 *    A. RECV->SPLICE (same-tid): original; labelled as possibly affected
 *       by thread reuse when alerting.
 *    B. EAGAIN->SPLICE (same-tid, same-fd): only fires when tid AND
 *       fd_in both match the prior EAGAIN record.
 *
 * 4. SCHED_RESUME root-cause label (kernel-level, most reliable):
 *    If wake_latency_us > 10s the alert distinguishes CFS vs Go runtime.
 *
 * Usage:
 *   BPFTRACE_MAX_MAP_KEYS=65536 bpftrace rootlessport_eagain_v2.bt \
 *       <rootlessport-parent-pid> \
 *       <rootlessport-child-pid> \
 *       <backend-app-pid-or-0>
 */

BEGIN
{
    printf("rootlessport_eagain_v2: parent=%d child=%d app=%d\n", $1, $2, $3);
    printf("Measurements:\n");
    printf("  RECV->SPLICE   : same-tid; may include unrelated thread work\n");
    printf("  EAGAIN->SPLICE : same-tid+same-fd; cleaner stall window\n");
    printf("  SCHED_RESUME   : kernel sched tracepoints; most reliable\n");
    printf("  CONFIRMED ALERT: epoll verified fd-ready during stall window\n\n");
}

/* ================================================================
   RECV - data arrived at rootlessport (SCM_RIGHTS or data path)
   ================================================================ */
tracepoint:syscalls:sys_exit_recvmsg
/ (pid == $1 || pid == $2) && args->ret > 0 /
{
    @recv[tid] = nsecs;
    printf("%llu RECV pid=%d tid=%d bytes=%d\n",
           nsecs, pid, tid, (int32)args->ret);
}

tracepoint:syscalls:sys_exit_read
/ (pid == $1 || pid == $2) && args->ret > 0 /
{
    @recv[tid] = nsecs;
    printf("%llu READ pid=%d tid=%d bytes=%d\n",
           nsecs, pid, tid, (int32)args->ret);
}

/* ================================================================
   EPOLL_PWAIT - Go's netpoller confirming fd readiness.
   When epoll_pwait returns > 0 at least one fd IS ready (kernel fact).
   Recorded per-pid because the netpoller goroutine may run on a
   different tid than the goroutine that later calls splice.
   ================================================================ */
tracepoint:syscalls:sys_exit_epoll_pwait
/ (pid == $1 || pid == $2) && (int32)args->ret > 0 /
{
    @epoll_ready_ns[pid] = nsecs;
    printf("%llu EPOLL_READY pid=%d tid=%d nfds=%d\n",
           nsecs, pid, tid, (int32)args->ret);
}

/* ================================================================
   SPLICE_EAGAIN - track per (tid, fd_in) for same-fd matching.
   ================================================================ */
tracepoint:syscalls:sys_exit_splice
/ (pid == $1 || pid == $2) && args->ret == -11 /
{
    $fd = args->fd_in;
    @eagain_ns[tid]  = nsecs;
    @eagain_fd[tid]  = $fd;
    @eagain_count[tid]++;

    printf("%llu SPLICE_EAGAIN pid=%d tid=%d fd_in=%d count=%llu\n",
           nsecs, pid, tid, $fd, @eagain_count[tid]);

    if (@epoll_ready_ns[pid] > 0) {
        $since = (nsecs - @epoll_ready_ns[pid]) / 1000;
        if ($since < 5000000) {
            printf("  epoll_ready %llu us ago (fd may already be ready)\n", $since);
        }
    }

    if (@recv[tid] > 0) {
        $lag = (nsecs - @recv[tid]) / 1000;
        printf("  RECV->EAGAIN delay: %llu us\n", $lag);
    }
}

/* ================================================================
   SPLICE_SUCCESS - two labelled measurements.
   ================================================================ */
tracepoint:syscalls:sys_exit_splice
/ (pid == $1 || pid == $2) && args->ret > 0 /
{
    $tid  = tid;
    $fd   = args->fd_in;

    /* ---- Measurement A: RECV->SPLICE (same tid) ---- */
    if (@recv[$tid] > 0) {
        $da = (nsecs - @recv[$tid]) / 1000;
        printf("%llu SPLICE_SUCCESS pid=%d tid=%d bytes=%d delay_us=%llu\n",
               nsecs, pid, $tid, (int32)args->ret, $da);
        if ($da > 1000000) {
            printf(">>> ALERT (RECV->SPLICE same-tid): %llu ms (thread-reuse possible) <<<\n",
                   $da / 1000);
        }
        delete(@recv[$tid]);
    } else {
        printf("%llu SPLICE_SUCCESS pid=%d tid=%d bytes=%d\n",
               nsecs, pid, $tid, (int32)args->ret);
    }

    /* ---- Measurement B: EAGAIN->SPLICE (same tid, same fd) ---- */
    if (@eagain_ns[$tid] > 0) {
        $db      = (nsecs - @eagain_ns[$tid]) / 1000;
        $prev_fd = @eagain_fd[$tid];

        if ($prev_fd == $fd) {
            /* Same tid AND same fd - strongest same-process measurement */
            printf("  EAGAIN->SPLICE (same-tid same-fd=%d): %llu us\n", $fd, $db);

            if ($db > 1000000) {
                $epoll_ok = (@epoll_ready_ns[pid] > @eagain_ns[$tid] &&
                             @epoll_ready_ns[pid] < nsecs);
                if ($epoll_ok) {
                    $lag2 = (nsecs - @epoll_ready_ns[pid]) / 1000;
                    printf(">>> CONFIRMED ALERT: fd=%d kernel-confirmed ready %llu ms before splice. Stall=%llu ms. fd WAS ready - goroutine not scheduled. <<<\n",
                           $fd, $lag2 / 1000, $db / 1000);
                } else {
                    printf(">>> ALERT (EAGAIN->SPLICE fd=%d): %llu ms stall. epoll not observed - fd readiness unconfirmed. <<<\n",
                           $fd, $db / 1000);
                }
            }
        } else {
            /* Different fd on same tid - cross-fd, discard */
            printf("  EAGAIN->SPLICE tid=%d fd changed %d->%d: %llu us [cross-fd, discarded]\n",
                   $tid, $prev_fd, $fd, $db);
        }
        delete(@eagain_ns[$tid]);
        delete(@eagain_fd[$tid]);
    }
}

/* ================================================================
   SCHED_RESUME - kernel scheduler evidence (most reliable).
   wake_latency_us   = CFS scheduling delay after sched_wakeup was called.
   total_since_eagain = full stall: Go runtime delay + CFS delay.
   These tracepoints have no goroutine-migration or fd ambiguity.
   ================================================================ */
tracepoint:sched:sched_wakeup
{
    @wake[(uint64)args->pid] = nsecs;
}

tracepoint:sched:sched_switch
{
    $next = (uint64)args->next_pid;

    if (@eagain_ns[$next] > 0 && @wake[$next] > 0) {
        $wl  = (nsecs - @wake[$next]) / 1000;
        $tot = (nsecs - @eagain_ns[$next]) / 1000;

        if ($wl > 1000) {
            printf("%llu SCHED_RESUME tid=%llu wake_latency_us=%llu total_since_eagain_us=%llu\n",
                   nsecs, $next, $wl, $tot);

            if ($tot > 1000000) {
                if ($wl > 10000) {
                    printf(">>> ALERT: Goroutine blocked %llu ms after EAGAIN! CFS=%llu ms. Root cause: BOTH Go runtime AND CFS delayed. <<<\n",
                           $tot / 1000, $wl / 1000);
                } else {
                    printf(">>> ALERT: Goroutine blocked %llu ms after EAGAIN! CFS=%llu ms. Root cause: Go runtime did not call sched_wakeup promptly. <<<\n",
                           $tot / 1000, $wl / 1000);
                }
            }
        }
        delete(@eagain_ns[$next]);
        delete(@wake[$next]);
    }
}

/* ================================================================
   Backend application send baseline
   ================================================================ */
kprobe:tcp_sendmsg
/ pid == $3 /
{
    printf("%llu APP_SEND tid=%d\n", nsecs, tid);
}

/* ================================================================
   Splice errors other than EAGAIN
   ================================================================ */
tracepoint:syscalls:sys_exit_splice
/ (pid == $1 || pid == $2) && args->ret < 0 && args->ret != -11 /
{
    printf("%llu SPLICE_ERROR pid=%d tid=%d errno=%d\n",
           nsecs, pid, tid, -(int32)args->ret);
}

END
{
    printf("\n=== Summary ===\n");
    printf("EAGAIN occurrences by TID:\n");
    print(@eagain_count);
    clear(@recv);
    clear(@eagain_ns); clear(@eagain_fd); clear(@eagain_count);
    clear(@wake); clear(@epoll_ready_ns);
}
